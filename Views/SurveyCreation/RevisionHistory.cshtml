@model List<SurveyApp.Models.SurveyRevisionModel>
@{
    ViewData["Title"] = "Revision History";
    var currentSurvey = ViewBag.CurrentSurvey as SurveyApp.Models.SurveyModel;
    var originalSurvey = ViewBag.OriginalSurvey as SurveyApp.Models.SurveyModel;
}

@section PageStyles {
    <style>
        /* Prevent horizontal overflow */
        body {
            overflow-x: hidden !important;
        }

        /* Mobile full-screen card */
        @@media (max-width: 767.98px) {
            .full-screen-card {
                min-height: 100vh;
                border-radius: 0 !important;
                margin: 0 !important;
            }
        }
        
        .timeline-marker {
            position: relative;
        }
        .timeline-marker::after {
            content: '';
            position: absolute;
            top: 40px;
            left: 50%;
            transform: translateX(-50%);
            width: 2px;
            height: calc(100% + 1rem);
            background: #dee2e6;
        }
        .timeline-item:last-child .timeline-marker::after {
            display: none;
        }
    </style>
}

<div class="container-fluid p-0 m-0">
    <div class="row g-0">
        <div class="col-12">
            <div class="card shadow mt-0 rounded-0 full-screen-card">
                <div class="card-header bg-purple py-2">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-white fs-4 mb-0">
                                <i class="bi bi-clock-history me-2"></i>Revision History
                            </h6>
                            <small class="text-white opacity-75">Track all revisions of this survey</small>
                        </div>
                        <a asp-action="CompletedSurveys" class="btn btn-outline-light text-white border-0">
                            <i class="bi bi-arrow-left"></i>
                            <span class="d-none d-md-inline ms-2">Back</span>
                        </a>
                    </div>
                </div>
                <div class="card-body p-3 p-md-4">
                    <!-- Survey Info Card -->
                    @if (currentSurvey != null)
                    {
                        <div class="card mb-4 border-0 shadow-sm" style="border-radius: 10px; overflow: hidden;">
                            <div class="card-body" style="background-color: #f8f9fa; padding: 1.5rem;">
                                <div class="row">
                                    <div class="col-md-6">
                                        <h6 class="text-muted mb-2">Current Survey</h6>
                                        <p class="mb-1"><strong>@currentSurvey.SurveyName</strong></p>
                                        <p class="mb-1 text-muted">
                                            <i class="bi bi-building me-1"></i>@(currentSurvey.ClientName ?? "N/A")
                                        </p>
                                        @if (currentSurvey.IsRevised)
                                        {
                                            <span class="badge bg-purple text-white">
                                                <i class="bi bi-arrow-repeat me-1"></i>Revision @currentSurvey.RevisionNumber
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-purple">
                                                <i class="bi bi-file-earmark me-1"></i>Original
                                            </span>
                                        }
                                    </div>
                                    @if (originalSurvey != null && originalSurvey.SurveyId != currentSurvey.SurveyId)
                                    {
                                        <div class="col-md-6">
                                            <h6 class="text-muted mb-2">Original Survey</h6>
                                            <p class="mb-1"><strong>@originalSurvey.SurveyName</strong></p>
                                            <a asp-action="SurveyLocation" asp-route-surveyId="@originalSurvey.SurveyId" 
                                               class="btn btn-outline-purple btn-sm">
                                                <i class="bi bi-eye me-1"></i>View Original
                                            </a>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Revision Timeline -->
                    <div class="card border-0 shadow-sm" style="border-radius: 10px; overflow: hidden;">
                        <div class="card-header py-3" style="background-color: rgb(159 139 233 / 20%);">
                            <h6 class="mb-0 text-purple">
                                <i class="bi bi-list-ul me-2"></i>Revision Timeline
                                @if (Model != null && Model.Count > 0)
                                {
                                    <span class="badge bg-purple text-white ms-2">@Model.Count</span>
                                }
                            </h6>
                        </div>
                        <div class="card-body p-3 p-md-4">
                            @if (Model != null && Model.Count > 0)
                            {
                                <div class="timeline">
                                    @foreach (var revision in Model.OrderByDescending(r => r.RevisionNumber))
                                    {
                                        <div class="timeline-item mb-4">
                                            <div class="d-flex">
                                                <div class="timeline-marker me-3">
                                                    <div class="bg-purple rounded-circle d-flex align-items-center justify-content-center" 
                                                         style="width: 40px; height: 40px;">
                                                        <strong class="text-white">@revision.RevisionNumber</strong>
                                                    </div>
                                                </div>
                                                <div class="timeline-content flex-grow-1">
                                                    <div class="card border-start border-purple border-3">
                                                        <div class="card-body">
                                                            <div class="d-flex justify-content-between align-items-start mb-2">
                                                                <div>
                                                                    <h6 class="mb-1">
                                                                        <a asp-action="SurveyLocation" asp-route-surveyId="@revision.RevisedSurveyId" class="text-purple">
                                                                            @revision.RevisedSurveyName
                                                                        </a>
                                                                    </h6>
                                                                    <small class="text-muted">
                                                                        <i class="bi bi-calendar me-1"></i>
                                                                        @revision.AssignedDate.ToString("dd MMM yyyy, hh:mm tt")
                                                                    </small>
                                                                </div>
                                                                <span class="badge @(revision.Status == "Completed" ? "bg-success" : 
                                                                                   revision.Status == "InProgress" ? "bg-warning text-dark" : 
                                                                                   revision.Status == "Cancelled" ? "bg-secondary" : "bg-info")">
                                                                    @revision.Status
                                                                </span>
                                                            </div>
                                                            
                                                            @if (!string.IsNullOrEmpty(revision.RevisionReason))
                                                            {
                                                                <p class="mb-2">
                                                                    <strong>Reason:</strong> @revision.RevisionReason
                                                                </p>
                                                            }
                                                            
                                                            <div class="row text-muted small">
                                                                <div class="col-md-6">
                                                                    <i class="bi bi-person me-1"></i>Assigned by: @(revision.AssignedByName ?? "Unknown")
                                                                </div>
                                                                @if (revision.CompletedDate.HasValue)
                                                                {
                                                                    <div class="col-md-6">
                                                                        <i class="bi bi-check-circle me-1"></i>
                                                                        Completed: @revision.CompletedDate.Value.ToString("dd MMM yyyy")
                                                                    </div>
                                                                }
                                                            </div>
                                                            
                                                            @if (!string.IsNullOrEmpty(revision.Notes))
                                                            {
                                                                <div class="mt-2 p-2 bg-light rounded">
                                                                    <small><i class="bi bi-sticky me-1"></i>@revision.Notes</small>
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="text-center py-5">
                                    <i class="bi bi-inbox text-muted" style="font-size: 48px;"></i>
                                    <p class="text-muted mt-3">No revisions found for this survey.</p>
                                    <p class="text-muted small">This survey has not been revised yet.</p>
                                    <a asp-action="CompletedSurveys" class="btn btn-purple mt-3">
                                        <i class="bi bi-arrow-left me-1"></i>Back to Completed Surveys
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
