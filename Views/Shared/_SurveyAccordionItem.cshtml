@using SurveyApp.Models
@model SurveyDetailsLocationModel

@{
    var hasItems = Model.ItemLists != null && Model.ItemLists.Any();
    var itemCount = hasItems ? Model.ItemLists.Count : 0;
    var totalQtyReq = hasItems ? Model.ItemLists.Sum(x => x.ItemQtyReq) : 0;
    var accordionClass = hasItems ? "card accordion-item shadow-sm mb-2 has-items" : "card accordion-item shadow-sm mb-2";
    var collapseId = $"collapse_{Model.ItemTypeID}"; // Use ItemTypeID for a stable ID
}

@* @if (hasItems)
{
    <div class="d-flex justify-content-between align-items-center mb-1 ps-2" style="font-size: 0.9rem; color: #555;">
        <div>
            <span class="badge bg-success text-white me-2">
                <i class="bi bi-check2-all me-1"></i>
                @itemCount item@(itemCount != 1 ? "s" : "")
            </span>
            @if (totalQtyReq > 0)
            {
                <span class="badge bg-primary text-white">
                    Qty: @totalQtyReq
