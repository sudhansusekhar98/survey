@using SurveyApp.Models
@{
    ViewData["Title"] = "Manage Specification Options";
    var spec = ViewBag.Specification as ItemSpecificationModel;
    var options = ViewBag.Options as List<SpecificationOptionModel> ?? new List<SpecificationOptionModel>();
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12 col-lg-10 mx-auto">
            <div class="card">
                <div class="card-header bg-purple custom-header d-flex align-items-center">
                    <h6 class="text-white mb-0 flex-grow-1">
                        <i class="bi bi-list-ul me-2"></i>Options for: @spec?.SpecificationName
                    </h6>
                    <a href="@Url.Action("Specifications", new { itemId = spec?.ItemId })"
                        class="btn btn-outline-light btn-sm">
                        <i class="bi bi-arrow-left me-1"></i> Back to Specifications
                    </a>
                </div>
                <div class="card-body">
                    @if (TempData["ResultMessage"] != null)
                    {
                        <div class="alert alert-@TempData["ResultType"] alert-dismissible fade show" role="alert">
                            @Html.Raw(TempData["ResultMessage"])
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <!-- Specification Info Card -->
                    <div class="card bg-light mb-4">
                        <div class="card-body py-3">
                            <div class="row">
                                <div class="col-md-4">
                                    <small class="text-muted">Specification ID</small>
                                    <div class="fw-bold">@spec?.SpecificationID</div>
                                </div>
                                <div class="col-md-4">
                                    <small class="text-muted">Input Type</small>
                                    <div>
                                        <span class="badge bg-info">@spec?.InputType</span>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <small class="text-muted">Display Rule</small>
                                    <div>@spec?.ConditionalDisplay</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Add Option Button -->
                    <div class="mb-3">
                        <a href="@Url.Action("CreateOption", new { specificationId = spec?.SpecificationID })"
                            class="btn btn-success">
                            <i class="bi bi-plus-circle me-1"></i> Add Option
                        </a>
                    </div>

                    <!-- Options Table -->
                    <div class="table-responsive">
                        <table class="table table-striped table-bordered">
                            <thead class="bg-purple text-white">
                                <tr>
                                    <th style="width: 60px;">Order</th>
                                    <th>Option Value</th>
                                    <th>Display Text</th>
                                    <th style="width: 100px;">Status</th>
                                    <th style="width: 120px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (options.Count > 0)
                                {
                                    foreach (var opt in options.OrderBy(o => o.DisplayOrder))
                                    {
                                        <tr>
                                            <td class="text-center">
                                                <span class="badge bg-secondary">@opt.DisplayOrder</span>
                                            </td>
                                            <td><code>@opt.OptionValue</code></td>
                                            <td><strong>@opt.OptionText</strong></td>
                                            <td class="text-center">
                                                @if (opt.IsActive)
                                                {
                                                    <span class="badge bg-success">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Inactive</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="d-flex gap-1 justify-content-center">
                                                    <a href="@Url.Action("EditOption", new { id = opt.OptionID })"
                                                        class="btn btn-sm btn-primary" title="Edit">
                                                        <i class="bi bi-pencil"></i>
                                                    </a>
                                                    <button type="button" class="btn btn-sm btn-danger"
                                                        onclick="deleteOption(@opt.OptionID, '@opt.OptionText.Replace("'", "\\'")' , @spec.SpecificationID)"
                                                        title="Delete">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center text-muted py-4">
                                            <i class="bi bi-inbox display-6 d-block mb-2"></i>
                                            No options defined yet. Click "Add Option" to create one.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (options.Count == 0)
                    {
                        <div class="alert alert-warning small">
                            <i class="bi bi-exclamation-triangle me-1"></i>
                            <strong>Note:</strong> Dropdown specifications without options will be displayed as text inputs.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Form -->
<form id="deleteForm" method="post" asp-action="DeleteOption" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="deleteOptionId" />
    <input type="hidden" name="specificationId" id="deleteSpecId" />
</form>

@section Scripts {
    <script>
        function deleteOption(id, name, specId) {
            Swal.fire({
                title: 'Delete Option?',
                html: `<p>Are you sure you want to delete "<strong>${name}</strong>"?</p>`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, Delete',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById('deleteOptionId').value = id;
                    document.getElementById('deleteSpecId').value = specId;
                    document.getElementById('deleteForm').submit();
                }
            });
        }
    </script>
}