@model SurveyApp.Models.SurveyDetailsUpdate
@{
    var allItems = Model?.ItemLists ?? new List<SurveyApp.Models.SurveyDetailsUpdatelist>();
    var selectedItems = allItems.Where(i => i.ItemQtyExist > 0 || i.ItemQtyReq > 0).ToList();
    var availableItems = allItems.Where(i => !(selectedItems.Select(s => s.ItemID).Contains(i.ItemID))).ToList();
}

<form asp-controller="SurveyDetails" asp-action="UpdateItem" method="post" class="item-selection-form"
    enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="SurveyID" />
    <input type="hidden" asp-for="LocID" />
    <input type="hidden" asp-for="ItemTypeID" />

    <div class="add-item-container mb-3 p-3 bg-light border rounded">
        <div class="row align-items-end">
            <div class="col-md-8">
                <label for="add-item-dropdown" class="form-label fw-semibold">Add a new item:</label>
                <select class="form-select" id="add-item-dropdown-@Model.ItemTypeID">
                    <option value="">-- Select an item --</option>
                    @foreach (var item in availableItems)
                    {
                        <option value="@item.ItemID" data-itemname="@item.ItemName" data-itemcode="@item.ItemCode"
                            data-iscamera="@item.IsCamera">@item.ItemName</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <button type="button" class="btn btn-success w-100 add-item-btn" data-itemtypeid="@Model.ItemTypeID">
                    <i class="bi bi-plus-circle me-1"></i> Add Item
                </button>
            </div>
        </div>
    </div>

    <div id="selected-items-container-@Model.ItemTypeID" class="selected-items-container"
        data-itemtypeid="@Model.ItemTypeID">
        <!-- Items that are already selected will be rendered here by JavaScript -->
    </div>

    <div class="row mt-4">
        <div class="col-12 text-end">
            <button type="submit" class="btn btn-primary me-2">
                <i class="bi bi-check-circle me-2"></i> Save All Changes
            </button>
            <button type="button" class="btn btn-secondary cancel-item-selection">
                <i class="bi bi-x-circle me-2"></i> Cancel
            </button>
        </div>
    </div>
</form>

<script>
    var allItemsData = @Html.Raw(Json.Serialize(allItems));
    var selectedItemsData = @Html.Raw(Json.Serialize(selectedItems));
</script>

<div id="item-form-template" style="display: none;">
    <div class="col-12 item-form-instance" data-item-id="{itemId}" data-item-code="{itemCode}"
        data-item-id-container="{index}">
        <input type="hidden" name="ItemLists[{index}].ItemID" value="{itemId}" class="item-id-field"
            data-index="{index}" />
        <input type="hidden" name="ItemLists[{index}].ItemName" value="{itemName}" />
        <input type="hidden" name="ItemLists[{index}].ItemCode" value="{itemCode}" class="item-code-field" />
        <input type="hidden" class="is-camera-item" data-index="{index}" value="{isCamera}" />
        <input type="hidden" class="camera-remarks-json" name="ItemLists[{index}].CameraRemarksJson"
            data-item-index="{index}" value="{cameraRemarksJson}" />

        <div class="card shadow-sm mb-3">
            <div class="card-header device-card-header-gradient py-2">
                <div class="d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-bold text-white fs-6">{itemName}</h6>
                    <button type="button" class="btn-close btn-close-white remove-item-btn" aria-label="Close"></button>
                </div>
            </div>
            <div class="card-body p-3">
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label fw-semibold text-primary mb-2">
                            <i class="bi bi-box-seam me-1"></i>Existing:
                        </label>
                        <div class="d-flex align-items-center">
                            <button type="button" class="btn btn-danger btn-sm me-2 cam-qty-minus" data-target="exist">
                                <i class="bi bi-dash"></i>
                            </button>
                            <input type="number" name="ItemLists[{index}].ItemQtyExist"
                                class="form-control text-center cam-qty-input cam-qty-exist" data-index="{index}"
                                data-type="exist" value="{itemQtyExist}" min="0" style="width: 5.5rem;" />
                            <button type="button" class="btn btn-success btn-sm ms-2 cam-qty-plus" data-target="exist">
                                <i class="bi bi-plus"></i>
                            </button>
                        </div>
                    </div>
                    <hr class="my-3" /> @* Horizontal line added here *@
                    <div class="col-12">
                        <label class="form-label fw-semibold text-success mb-2">
                            <i class="bi bi-plus-circle me-1"></i>Required (To Deploy):
                        </label>
                        <div class="d-flex align-items-center">
                            <button type="button" class="btn btn-danger btn-sm me-2 cam-qty-minus" data-target="req">
                                <i class="bi bi-dash"></i>
                            </button>
                            <input type="number" name="ItemLists[{index}].ItemQtyReq"
                                class="form-control text-center cam-qty-input cam-qty-req" data-index="{index}"
                                data-type="req" value="{itemQtyReq}" min="0" style="width: 5.5rem;" />
                            <button type="button" class="btn btn-success btn-sm ms-2 cam-qty-plus" data-target="req">
                                <i class="bi bi-plus"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Expandable section shown when either quantity > 0 -->
                <div class="cam-extra-section mt-3 pt-3 border-top" style="display: none;">

                    <!-- Dynamic Item Specifications Section (Pole Owner, Height, Road Width, etc.) -->
                    <!-- Loaded from ItemSpecificationMaster and ItemSpecificationOptionsMaster tables -->
                    <div class="item-specifications-section mb-3" data-item-id="{itemId}" data-item-index="{index}">
                        <div class="row g-3 specifications-container">
                            <!-- Specifications will be dynamically loaded here via JavaScript -->
                            <div class="col-12 specifications-loading text-center py-2 d-none">
                                <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                                <span class="text-muted small">Loading specifications...</span>
                            </div>
                        </div>
                    </div>

                    <!-- Image capture section (shown only for Camera, Rack, Infrastructure, Public Announcement) -->
                    <div class="image-capture-section mb-3" data-item-index="{index}" style="display: none;">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-camera me-1"></i>Images
                        </label>
                        <input type="file" class="form-control mb-2 cam-upload-input" multiple accept="image/*"
                            style="display:none;" />
                        <div class="d-flex flex-column flex-sm-row gap-2 mb-2">
                            <button type="button" class="btn btn-success btn-lg cam-take-photo-btn shadow"
                                style="background: linear-gradient(135deg, #28a745, #20c997); border: none;">
                                <i class="bi bi-camera-fill me-1"></i> Take Photo
                            </button>
                            <button type="button" class="btn btn-primary btn-sm cam-gallery-btn">
                                <i class="bi bi-images me-1"></i> Gallery
                            </button>
                        </div>
                        <div class="cam-preview mt-2 d-flex flex-wrap gap-2" data-item-index="{index}">
                            <!-- Existing images will be shown here -->
                        </div>
                        <input type="hidden" name="ItemLists[{index}].CloudinaryUrls" class="cloudinary-urls-input"
                            value="{cloudinaryUrls}" />
                        <input type="hidden" name="ItemLists[{index}].CloudinaryPublicIds"
                            class="cloudinary-publicids-input" value="{cloudinaryPublicIds}" />
                    </div>

                    <!-- Camera Installation Remarks Section (only for camera items) -->
                    <div class="camera-remarks-section" data-item-index="{index}" style="display: none;">
                        <div class="camera-remarks-inputs-container" id="cameraRemarksInputs_{index}">
                            <!-- Dynamic camera remark inputs will be inserted here by JavaScript -->
                        </div>
                    </div>

                    <div class="mt-3">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-chat-left-text me-1"></i>Remarks
                        </label>
                        <textarea name="ItemLists[{index}].Remarks" class="form-control"
                            placeholder="Enter additional remarks..." rows="2">{remarks}</textarea>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Dynamic Item Specifications Handler
    (function () {
        'use strict';

        const specConfig = {
            getSpecificationsUrl: '@Url.Action("GetItemSpecifications", "SurveyDetails")',
            getSpecificationDetailsUrl: '@Url.Action("GetSpecificationDetails", "SurveyDetails")',
            surveyId: @Model.SurveyID,
            locId: @Model.LocID
    };

        // Cache for loaded specifications
        const specsCache = {};

        /**
         * Collect current DOM values for specifications before re-rendering
         */
        function collectCurrentDomValues(container) {
            const domValues = [];
            const card = container.closest('.card');
            if (!card) return domValues;

            // Find all specification inputs in the card (they may be placed in different locations)
            const specInputs = card.querySelectorAll('input[name^="ItemSpecs_"], select[name^="ItemSpecs_"]');
            specInputs.forEach(input => {
                // Parse the name: ItemSpecs_{itemIndex}_{specId}_{instance}
                const nameParts = input.name.split('_');
                if (nameParts.length >= 4) {
                    const specId = parseInt(nameParts[2]);
                    const instance = parseInt(nameParts[3]);
                    if (!isNaN(specId) && !isNaN(instance)) {
                        domValues.push({
                            specificationID: specId,
                            instanceNumber: instance,
                            value: input.value
                        });
                    }
                }
            });
            return domValues;
        }

        /**
         * Load specifications for an item and render them
         */
        async function loadItemSpecifications(container) {
            const itemId = parseInt(container.dataset.itemId);
            const itemIndex = container.dataset.itemIndex;

            if (!itemId || itemId <= 0) {
                console.log('No valid itemId for specifications');
                return;
            }

            const specsContainer = container.querySelector('.specifications-container');
            const loadingEl = container.querySelector('.specifications-loading');

            // Collect current DOM values BEFORE clearing/re-rendering
            const currentDomValues = collectCurrentDomValues(container);

            // Show loading
            if (loadingEl) loadingEl.classList.remove('d-none');

            try {
                // Fetch specifications (with options included)
                let specifications = specsCache[itemId];
                if (!specifications) {
                    const response = await fetch(`${specConfig.getSpecificationsUrl}?itemId=${itemId}`);
                    const data = await response.json();

                    if (data.success && data.specifications) {
                        specifications = data.specifications;
                        specsCache[itemId] = specifications;
                    }
                }

                if (!specifications || specifications.length === 0) {
                    // No specifications for this item
                    if (loadingEl) loadingEl.classList.add('d-none');
                    return;
                }

                // Try to load saved values
                let savedDetails = [];
                try {
                    const detailsResponse = await fetch(
                        `${specConfig.getSpecificationDetailsUrl}?surveyId=${specConfig.surveyId}&locId=${specConfig.locId}&itemId=${itemId}`
                    );
                    const detailsData = await detailsResponse.json();
                    if (detailsData.success && detailsData.specifications) {
                        savedDetails = detailsData.specifications;
                    }
                } catch (e) {
                    console.log('Could not load saved specification details:', e);
                }

                // Merge DOM values with saved details (DOM values take precedence)
                // This preserves unsaved user input when quantities change
                currentDomValues.forEach(domVal => {
                    // Find if this spec/instance exists in savedDetails
                    const existingIdx = savedDetails.findIndex(sd =>
                        sd.specificationID === domVal.specificationID &&
                        sd.instanceNumber === domVal.instanceNumber
                    );
                    if (existingIdx >= 0) {
                        // Override with DOM value
                        savedDetails[existingIdx].value = domVal.value;
                    } else {
                        // Add DOM value as new entry
                        savedDetails.push(domVal);
                    }
                });

                // Get quantities for conditional display
                const card = container.closest('.card');
                const existQty = parseInt(card?.querySelector('.cam-qty-exist')?.value || 0);
                const reqQty = parseInt(card?.querySelector('.cam-qty-req')?.value || 0);

                // Render specifications
                renderSpecifications(specsContainer, specifications, savedDetails, itemIndex, existQty, reqQty);

                // If no specifications are left in the main container, hide the container itself
                if (specsContainer.querySelectorAll('.specification-field').length === 0) {
                    container.classList.add('d-none');
                } else {
                    container.classList.remove('d-none');
                }
            } catch (error) {
                console.error('Error loading specifications:', error);
            } finally {
                if (loadingEl) loadingEl.classList.add('d-none');
            }
        }

        /**
         * Render specifications based on conditional display rules
         */
        function renderSpecifications(container, specifications, savedDetails, itemIndex, existQty, reqQty) {
            // Clear existing specifications (except loading indicator)
            const existingSpecs = container.querySelectorAll('.specification-field');
            existingSpecs.forEach(el => el.remove());

            const card = container.closest('.card');
            const existQtyParent = card?.querySelector('.cam-qty-exist')?.closest('.col-12');
            const reqQtyParent = card?.querySelector('.cam-qty-req')?.closest('.col-12');

            specifications.forEach(spec => {
                // Check conditional display
                if (!shouldShowSpecification(spec, existQty, reqQty)) {
                    return; // Skip this specification
                }

                // Determine number of instances to show
                const instanceCount = getInstanceCount(spec, existQty, reqQty);
                const specNameLower = (spec.specificationName || '').toLowerCase();

                for (let instance = 1; instance <= instanceCount; instance++) {
                    const savedValue = getSavedValue(savedDetails, spec.specificationID, instance);
                    const fieldHtml = createSpecificationField(spec, itemIndex, instance, instanceCount, savedValue);

                    if (specNameLower.includes('pole owner') && existQtyParent) {
                        existQtyParent.insertAdjacentHTML('afterend', fieldHtml);
                    } else if (specNameLower.includes('pole height') && reqQtyParent) {
                        reqQtyParent.insertAdjacentHTML('afterend', fieldHtml);
                    } else {
                        container.insertAdjacentHTML('beforeend', fieldHtml);
                    }
                }
            });
        }

        /**
         * Check if specification should be shown based on conditional display rule
         */
        function shouldShowSpecification(spec, existQty, reqQty) {
            const specNameLower = (spec.specificationName || '').toLowerCase();

            // Explicitly handle "Pole Owner" and "Pole Height"
            if (specNameLower.includes('pole owner')) {
                return existQty > 0; // Only show if existing quantity > 0
            }
            if (specNameLower.includes('pole height')) {
                return reqQty > 0; // Only show if required quantity > 0
            }

            const rule = (spec.conditionalDisplay || 'Always').toLowerCase();

            switch (rule) {
                case 'existingqtyonly':
                    return existQty > 0;
                case 'requiredqtyonly':
                    return reqQty > 0;
                case 'bothqty':
                    return existQty > 0 || reqQty > 0;
                case 'always':
                default:
                    return true;
            }
        }

        /**
         * Get number of instances to show
         */
        function getInstanceCount(spec, existQty, reqQty) {
            if (!spec.allowMultipleInstances) {
                return 1;
            }

            const rule = (spec.conditionalDisplay || 'Always').toLowerCase();

            switch (rule) {
                case 'existingqtyonly':
                    return existQty;
                case 'requiredqtyonly':
                    return reqQty;
                case 'bothqty':
                    return Math.max(existQty, reqQty);
                default:
                    return 1;
            }
        }

        /**
         * Get saved value for a specification instance
         */
        function getSavedValue(savedDetails, specId, instance) {
            const saved = savedDetails.find(s =>
                s.specificationID === specId &&
                (s.instanceNumber || 1) === instance
            );
            return saved?.specificationDetails || '';
        }

        /**
         * Create HTML for a specification field
         */
        function createSpecificationField(spec, itemIndex, instance, totalInstances, savedValue) {
            const fieldId = `spec_${itemIndex}_${spec.specificationID}_${instance}`;
            const fieldName = `ItemSpecs_${itemIndex}_${spec.specificationID}_${instance}`;
            const label = totalInstances > 1 ? `${spec.specificationName} #${instance}` : spec.specificationName;

            let inputHtml = '';

            if (spec.inputType?.toLowerCase() === 'dropdown' && spec.optionsList && spec.optionsList.length > 0) {
                // Dropdown with options from database
                const optionsHtml = spec.optionsList.map(opt =>
                    `<option value="${escapeHtml(opt.optionValue)}" ${savedValue === opt.optionValue ? 'selected' : ''}>${escapeHtml(opt.optionText)}</option>`
                ).join('');

                inputHtml = `
                <select id="${fieldId}" name="${fieldName}" class="form-select spec-input" 
                        data-spec-id="${spec.specificationID}" data-instance="${instance}">
                    <option value="">-- Select ${spec.specificationName} --</option>
                    ${optionsHtml}
                </select>`;
            } else {
                // Text input
                inputHtml = `
                <input type="text" id="${fieldId}" name="${fieldName}" class="form-control spec-input"
                       data-spec-id="${spec.specificationID}" data-instance="${instance}"
                       placeholder="Enter ${spec.specificationName}..." value="${escapeHtml(savedValue)}" />`;
            }

            return `
            <div class="col-12 col-md-6 specification-field" data-spec-id="${spec.specificationID}" data-instance="${instance}">
                <label class="form-label fw-semibold text-info" for="${fieldId}">
                    <i class="bi bi-${getIconForSpec(spec.specificationName)} me-1"></i>${escapeHtml(label)}
                </label>
                ${inputHtml}
            </div>`;
        }

        /**
         * Get Bootstrap icon for specification name
         */
        function getIconForSpec(name) {
            const lowerName = (name || '').toLowerCase();
            if (lowerName.includes('owner')) return 'building';
            if (lowerName.includes('height')) return 'arrows-vertical';
            if (lowerName.includes('width') || lowerName.includes('road')) return 'signpost-2';
            return 'list-check';
        }

        /**
         * Escape HTML to prevent XSS
         */
        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text || '';
            return div.innerHTML;
        }

        /**
         * Initialize specifications for all visible items
         */
        function initializeAllSpecifications() {
            document.querySelectorAll('.item-specifications-section').forEach(section => {
                loadItemSpecifications(section);
            });
        }

        /**
         * Setup quantity change listeners to reload specifications
         */
        function setupQuantityChangeListeners() {
            document.addEventListener('change', function (e) {
                if (e.target.classList.contains('cam-qty-input')) {
                    const card = e.target.closest('.card');
                    if (card) {
                        const specSection = card.querySelector('.item-specifications-section');
                        if (specSection) {
                            loadItemSpecifications(specSection);
                        }
                    }
                }
            });
        }

        // Expose function globally for dynamic item addition
        window.loadItemSpecifications = loadItemSpecifications;
        window.initializeAllSpecifications = initializeAllSpecifications;

        // Initialize when DOM is ready
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', function () {
                initializeAllSpecifications();
                setupQuantityChangeListeners();
            });
        } else {
            initializeAllSpecifications();
            setupQuantityChangeListeners();
        }
    })();
</script>