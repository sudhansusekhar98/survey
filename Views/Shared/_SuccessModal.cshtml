@* Success Modal - displayed after successful operations *@
<div class="modal fade" id="SuccessModal" data-bs-backdrop="static" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-white">
                    <i class="bi bi-check-circle-fill"></i>
                    Success!
                </h5>
            </div>
            <div class="modal-body text-center">
                <i class="bi bi-check-circle-fill text-success" style="font-size: 3rem;"></i>
                <p class="h6 mb-0" id="successModalMessage">Record processed successfully.</p>
            </div>
            <div class="modal-footer">
                <a id="btnConformOk" href="#" class="btn btn-success">
                    <i class="bi bi-check2-circle"></i>OK
                </a>
            </div>
        </div>
    </div>
</div>
