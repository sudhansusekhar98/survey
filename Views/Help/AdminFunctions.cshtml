                                <i class="bi bi-people me-2"></i>Team Assignment
                            </a>
                        </div>
                        <div class="col-md-3">
                            <a asp-action="SurveySubmission" class="btn btn-outline-danger btn-help w-100">
                                <i class="bi bi-send me-2"></i>Submission & Review
                            </a>
                        </div>
                        <div class="col-md-3">
                            <a asp-action="Index" class="btn btn-outline-secondary btn-help w-100">
                                <i class="bi bi-arrow-left me-2"></i>Help Center
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>