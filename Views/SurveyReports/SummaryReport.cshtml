@model SurveyApp.Models.SurveyReportViewModel
@{
    ViewData["Title"] = "Survey Summary Report";
    var roleId = Context.Session.GetString("RoleId") ?? "102";
    var isSuperAdmin = roleId == "101";
}

<div class="container-fluid">
    <!-- OTP Authorization Warning (shown when OTP is required) -->
    @if (TempData["RequireOTP"] != null && (bool)TempData["RequireOTP"])
    {
        <div class="alert alert-warning alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
            <i class="bx bx-shield-quarter bx-lg me-3"></i>
            <div class="flex-grow-1">
                <strong>OTP Verification Required!</strong> To download reports, you need to request an OTP and get it validated by a Super Admin.
            </div>
            <button type="button" class="btn btn-warning btn-sm ms-3" onclick="ReportOTPModule.showOTPModal()">
                <i class="bx bx-key me-1"></i>Request OTP
            </button>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="fw-bold text-purple mb-1">
                        <i class="bi bi-file-earmark-bar-graph-fill me-2"></i>@Model.ReportTitle
                    </h2>
                    <p class="text-muted mb-0">
                        <i class="bi bi-calendar3 me-1"></i>Generated on @Model.GeneratedDate.ToString("dd MMM yyyy, HH:mm")
                        <span class="mx-2">|</span>
                        <i class="bi bi-person-circle me-1"></i>By @Model.GeneratedBy
                    </p>
                </div>
                <div>
                    <button onclick="window.print()" class="btn btn-outline-purple btn-sm me-2 shadow-sm">
                        <i class="bi bi-printer-fill me-1"></i>Print
                    </button>
                    @if (isSuperAdmin)
                    {
                        <!-- Super Admin can download directly -->
                        <a asp-action="ExportToExcel" 
                           asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
                           asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")"
                           asp-route-status="@Model.Status"
                           asp-route-region="@Model.Region"
                           asp-route-type="@Model.ImplementationType"
                           class="btn btn-success btn-sm shadow-sm">
                            <i class="bi bi-file-earmark-excel-fill me-1"></i>Export Excel
                        </a>
                    }
                    else
                    {
                        <!-- Non-super admins need OTP verification -->
                        <button type="button" class="btn btn-success btn-sm shadow-sm" id="btnExportExcel"
                                data-from-date="@Model.FromDate?.ToString("yyyy-MM-dd")"
                                data-to-date="@Model.ToDate?.ToString("yyyy-MM-dd")"
                                data-status="@Model.Status"
                                data-region="@Model.Region"
                                data-type="@Model.ImplementationType">
                            <i class="bi bi-file-earmark-excel-fill me-1"></i>Export Excel
                            <i class="bx bx-lock-alt ms-1" title="OTP Required"></i>
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Card -->
 <div class="card mb-3 border-0.5 shadow-sm no-print" style="border-radius: 10px; overflow: hidden; margin-top: 0.25rem;">
                <div class="card-body" style="background-color: #f8f9fa; padding: 1.5rem;">
                    <form asp-action="SummaryReport" method="get">
                        <div class="row g-3">
                            <div class="col-12 col-md-6 col-lg-3">
                                <label class="form-label fw-semibold small text-secondary mb-2">
                                    <i class="bi bi-calendar-event me-1 text-primary"></i>From Date
                                </label>
                                <input type="date" name="fromDate" class="form-control shadow-sm" value="@Model.FromDate?.ToString("yyyy-MM-dd")" style="border-radius: 8px; border: 1px solid #dee2e6;">
                            </div>
                            <div class="col-12 col-md-6 col-lg-3">
                                <label class="form-label fw-semibold small text-secondary mb-2">
                                    <i class="bi bi-calendar-check me-1 text-success"></i>To Date
                                </label>
                                <input type="date" name="toDate" class="form-control shadow-sm" value="@Model.ToDate?.ToString("yyyy-MM-dd")" style="border-radius: 8px; border: 1px solid #dee2e6;">
                            </div>
                            <div class="col-12 col-md-6 col-lg-2">
                                <label class="form-label fw-semibold small text-secondary mb-2">
                                    <i class="bi bi-funnel me-1 text-primary"></i>Status
                                </label>
                                <select name="status" class="form-select shadow-sm" style="border-radius: 8px; border: 1px solid #dee2e6;">
                                    <option value="">All Statuses</option>
                                    @if (ViewBag.StatusOptions != null)
                                    {
                                        foreach (var status in ViewBag.StatusOptions)
                                        {
                                            <option value="@status" selected="@(Model.Status == status)">@status</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-12 col-md-6 col-lg-2">
                                <label class="form-label fw-semibold small text-secondary mb-2">
                                    <i class="bi bi-map me-1 text-success"></i>Region
                                </label>
                                <select name="region" class="form-select shadow-sm" style="border-radius: 8px; border: 1px solid #dee2e6;">
                                    <option value="">All Regions</option>
                                    @if (ViewBag.RegionOptions != null)
                                    {
                                        foreach (var region in ViewBag.RegionOptions)
                                        {
                                            <option value="@region" selected="@(Model.Region == region)">@region</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-12 col-md-6 col-lg-2">
                                <label class="form-label fw-semibold small text-secondary mb-2">
                                    <i class="bi bi-building me-1 text-warning"></i>Implementation Type
                                </label>
                                <select name="type" class="form-select shadow-sm" style="border-radius: 8px; border: 1px solid #dee2e6;">
                                    <option value="">All Types</option>
                                    @if (ViewBag.TypeOptions != null)
                                    {
                                        foreach (var type in ViewBag.TypeOptions)
                                        {
                                            <option value="@type" selected="@(Model.ImplementationType == type)">@type</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                        
                        <div class="row mt-4">
                            <div class="col-12">
                                <div class="d-flex gap-2 flex-wrap">
                                    <button type="submit" class="btn btn-purple shadow-sm px-4" style="border-radius: 8px;">
                                        <i class="bi bi-funnel-fill me-2"></i>Apply Filters
                                    </button>
                                    <a asp-action="SummaryReport" class="btn btn-outline-secondary shadow-sm px-4" style="border-radius: 8px;">
                                        <i class="bi bi-x-circle me-2"></i>Clear All Filters
                                    </a>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

    <!-- Summary Statistics -->
    <div class="row mb-4 g-3">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 12px; overflow: hidden;">
                <div class="card-body p-4" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div class="text-white">
                            <div class="opacity-75 small mb-1">Total Surveys</div>
                            <h2 class="mb-0 fw-bold" style="color: white; !important">@Model.TotalSurveys</h2>
                        </div>
                        <div class="p-3 rounded-circle" style="background-color: rgba(118, 75, 162, 0.3);">
                            <i class="bi bi-clipboard-data text-white" style="font-size: 1.5rem;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 12px; overflow: hidden;">
                <div class="card-body p-4" style="background: linear-gradient(135deg, #06d6a0 0%, #1b9a6b 100%);">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div class="text-white">
                            <div class="opacity-75 small mb-1">Completed</div>
                            <h2 class="mb-0 fw-bold" style="color: white; !important">@Model.CompletedSurveys</h2>
                            <div class="small mt-1">
                                <i class="bi bi-graph-up-arrow me-1"></i>@Model.CompletionRate% completion
                            </div>
                        </div>
                        <div class="p-3 rounded-circle" style="background-color: rgba(27, 154, 107, 0.3);">
                            <i class="bi bi-check-circle-fill text-white" style="font-size: 1.5rem;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 12px; overflow: hidden;">
                <div class="card-body p-4" style="background: linear-gradient(135deg, #ffc93c 0%, #ff9a3c 100%);">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div class="text-white">
                            <div class="opacity-75 small mb-1">In Progress</div>
                            <h2 class="mb-0 fw-bold" style="color: white; !important">@Model.InProgressSurveys</h2>
                        </div>
                        <div class="p-3 rounded-circle" style="background-color: rgba(255, 154, 60, 0.3);">
                            <i class="bi bi-hourglass-split text-white" style="font-size: 1.5rem;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 12px; overflow: hidden;">
                <div class="card-body p-4" style="background: linear-gradient(135deg, #ff6b6b 0%, #c92a2a 100%);">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div class="text-white">
                            <div class="opacity-100 small mb-1">Missed Deadline</div>
                            <h2 class="mb-0 fw-bold" style="color: white; !important">@Model.MissedDeadlineSurveys</h2>
                        </div>
                        <div class="p-3 rounded-circle" style="background-color: rgba(201, 42, 42, 0.3);">
                            <i class="bi bi-calendar-x-fill text-white" style="font-size: 1.5rem;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row -->
    <div class="row mb-4 g-3">
        <div class="col-md-4">
            <div class="card shadow-sm border-0" style="border-radius: 12px; overflow: hidden;">
                <div class="card-header bg-white border-0 pt-4 pb-3">
                    <h6 class="mb-0 fw-bold text-purple">
                        <i class="bi bi-pie-chart-fill me-2"></i>Status Breakdown
                    </h6>
                </div>
                <div class="card-body">
                    @if (Model.SurveysByStatus.Any())
                    {
                        <canvas id="statusChart" style="max-height: 250px;"></canvas>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
                            <p class="text-muted mt-2">No data available</p>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0" style="border-radius: 12px; overflow: hidden;">
                <div class="card-header bg-white border-0 pt-4 pb-3">
                    <h6 class="mb-0 fw-bold text-purple">
                        <i class="bi bi-geo-alt-fill me-2"></i>Region Distribution
                    </h6>
                </div>
                <div class="card-body">
                    @if (Model.SurveysByRegion.Any())
                    {
                        <canvas id="regionChart" style="max-height: 250px;"></canvas>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
                            <p class="text-muted mt-2">No data available</p>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0" style="border-radius: 12px; overflow: hidden;">
                <div class="card-header bg-white border-0 pt-4 pb-3">
                    <h6 class="mb-0 fw-bold text-purple">
                        <i class="bi bi-bar-chart-fill me-2"></i>Implementation Types
                    </h6>
                </div>
                <div class="card-body">
                    @if (Model.SurveysByImplementationType.Any())
                    {
                        <canvas id="typeChart" style="max-height: 250px;"></canvas>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
                            <p class="text-muted mt-2">No data available</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Survey List Table -->
    <div class="card shadow-sm border-0" style="border-radius: 12px; overflow: hidden;">
        <div class="card-header bg-purple py-3">
            <h6 class="mb-0 text-white fw-bold">
                <i class="bi bi-table me-2"></i>Survey Details
                <span class="badge bg-white text-purple ms-2">@Model.Surveys.Count surveys</span>
            </h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover datatables-basic mb-0 table-compact">
                    <thead style="background-color: #f8f9fa;">
                        <tr>
                            <th class="fw-semibold">Survey ID</th>
                            <th class="fw-semibold">Survey Name</th>
                            <th class="fw-semibold">Status</th>
                            <th class="fw-semibold">Region</th>
                            <th class="fw-semibold">Type</th>
                            <th class="fw-semibold">Date</th>
                            <th class="fw-semibold">Submitted Date</th>
                            <th class="fw-semibold">Due Date</th>
                            <th class="fw-semibold no-print">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var survey in Model.Surveys)
                        {
                            var statusClass = survey.SurveyStatus switch
                            {
                                "Completed" => "success",
                                "In Progress" => "warning",
                                "Pending" => "secondary",
                                "On Hold" => "danger",
                                _ => "dark"
                            };
                            var isOverdue = survey.DueDate.HasValue && survey.DueDate.Value < DateTime.Now && survey.SurveyStatus != "Completed";

                            <tr>
                                <td class="fw-semibold text-purple">#@survey.SurveyId</td>
                                <td>@survey.SurveyName</td>
                                <td>
                                    <span class="badge bg-@statusClass rounded-pill px-3">
                                        @survey.SurveyStatus
                                    </span>
                                </td>
                                <td>
                                    <i class="bi bi-geo-alt text-muted me-1"></i>@survey.RegionName
                                </td>
                                <td>@survey.ImplementationType</td>
                                <td>@(survey.SurveyDate?.ToString("dd-MMM-yyyy") ?? "-")</td>
                                <td>
                                    @if (survey.SubmittedDate.HasValue)
                                    {
                                        <span class="text-success">
                                            <i class="bi bi-check-circle me-1"></i>@survey.SubmittedDate.Value.ToString("dd-MMM-yyyy HH:mm")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (survey.DueDate.HasValue)
                                    {
                                        <span class="@(isOverdue ? "text-danger fw-bold" : "")">
                                            @survey.DueDate.Value.ToString("dd-MMM-yyyy")
                                            @if (isOverdue)
                                            {
                                                <i class="bi bi-exclamation-triangle-fill ms-1"></i>
                                            }
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="no-print">
                                    <a asp-action="DetailedReport" asp-route-surveyId="@survey.SurveyId" 
                                       class="btn btn-sm btn-purple rounded-pill px-3">
                                        <i class="bi bi-eye-fill me-1"></i>View
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-2 ms-1"
                                            onclick="showRequirementSummary(@survey.SurveyId)"
                                            title="View Requirement Summary">
                                        <i class="bi bi-table"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Requirement Summary Section -->
    <div class="card shadow-sm border-0 mt-4" style="border-radius: 12px; overflow: hidden;" id="requirementSummarySection">
        <div class="card-header bg-success py-3">
            <div class="d-flex justify-content-between align-items-center">
                <h6 class="mb-0 text-white fw-bold">
                    <i class="bi bi-grid-3x3-gap-fill me-2"></i>Requirement Summary
                </h6>
                <div class="d-flex align-items-center">
                    <select id="surveySelector" class="form-select form-select-sm me-2" style="width: 300px; border-radius: 8px;">
                        <option value="">-- Select a Survey --</option>
                        @foreach (var survey in Model.Surveys)
                        {
                            var isSelected = ViewBag.SelectedSurveyId != null && (long)ViewBag.SelectedSurveyId == survey.SurveyId;
                            <option value="@survey.SurveyId" selected="@(isSelected ? "selected" : null)">
                                #@survey.SurveyId - @survey.SurveyName
                            </option>
                        }
                    </select>
                    <button type="button" class="btn btn-light btn-sm" onclick="loadRequirementSummary()">
                        <i class="bi bi-arrow-repeat me-1"></i>Load
                    </button>
                </div>
            </div>
        </div>
        <div class="card-body p-0" id="requirementSummaryContent">
            @{
                var requirementSummary = ViewBag.RequirementSummary as SurveyApp.Models.RequirementSummaryModel;
                var selectedSurvey = ViewBag.SelectedSurvey as SurveyApp.Models.SurveyModel;
            }
            @if (requirementSummary != null && requirementSummary.Locations.Any())
            {
                <div class="p-3">
                    <div class="alert alert-info mb-3">
                        <div class="row">
                            <div class="col-md-4">
                                <strong><i class="bi bi-clipboard-data me-1"></i>Survey:</strong> 
                                @requirementSummary.SurveyName
                            </div>
                            <div class="col-md-4">
                                <strong><i class="bi bi-building me-1"></i>Client:</strong> 
                                @requirementSummary.ClientName
                            </div>
                            <div class="col-md-4">
                                <strong><i class="bi bi-geo-alt me-1"></i>Locations:</strong> 
                                <span class="badge bg-success">@requirementSummary.Locations.Count</span>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="table-responsive">
                    <table class="table table-bordered table-hover mb-0 table-compact" style="font-size: 0.85rem;">
                        @{
                            // STEP 1: PRE-CALCULATE ALL TOTALS FIRST (before rendering anything)
                            var allDeviceTypesFromCategories = requirementSummary.DeviceCategories.SelectMany(c => c.Value).ToList();
                            
                            // Calculate totals for each device type
                            var existingTotals = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
                            var requiredTotals = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
                            
                            foreach (var deviceType in allDeviceTypesFromCategories)
                            {
                                existingTotals[deviceType] = 0;
                                requiredTotals[deviceType] = 0;
                            }
                            
                            // Sum up totals from all locations
                            foreach (var location in requirementSummary.Locations)
                            {
                                foreach (var deviceData in location.DeviceData)
                                {
                                    var key = deviceData.Key;
                                    if (existingTotals.ContainsKey(key))
                                    {
                                        existingTotals[key] += deviceData.Value.ExistingQty;
                                        requiredTotals[key] += deviceData.Value.RequiredQty;
                                    }
                                }
                            }
                            
                            // STEP 2: TRACK GRANULAR VISIBILITY
                            // Column visibility is driven by the DeviceColumnVisibility dictionary from the model
                            var devColVis = requirementSummary.DeviceColumnVisibility ?? new Dictionary<string, bool[]>();
                            
                            var visibleDeviceTypes = allDeviceTypesFromCategories
                                .Where(dt => devColVis.ContainsKey(dt) && devColVis[dt].Any(v => v))
                                .ToList();
                            
                            // Build filtered categories - only include categories with visible device types
                            var filteredCategories = new Dictionary<string, List<string>>();
                            foreach (var category in requirementSummary.DeviceCategories)
                            {
                                var visibleItems = category.Value.Where(item => visibleDeviceTypes.Contains(item)).ToList();
                                if (visibleItems.Any())
                                {
                                    filteredCategories[category.Key] = visibleItems;
                                }
                            }
                            
                            // Global flag for any existing data (if needed)
                            bool showExistingColumn = existingTotals.Any(t => visibleDeviceTypes.Contains(t.Key) && t.Value > 0);
                            
                            // Calculate columns per device type
                            int colsPerDevice = showExistingColumn ? 4 : 3;  // Existing, Required, Images, Remarks OR just Required, Images, Remarks
                        }
                        
                        @if (visibleDeviceTypes.Any())
                        {
                        <thead>
                            <!-- Row 1: Main category headers -->
                            <tr>
                                <!-- Location Panel -->
                                <th class="text-center align-middle text-white" rowspan="3" style="background-color: #70ad47; min-width: 50px;">SL.No</th>
                                <th class="text-center align-middle text-white" rowspan="3" style="background-color: #70ad47; min-width: 150px;">Location Name</th>
                                
                                <!-- Geo Coordinates -->
                                <th class="text-center text-white" colspan="3" rowspan="2" style="background-color: #5b9bd5;">Geo coordinates</th>
                                
                                <!-- Category Headers - ONLY for categories with visible device types -->
                                @foreach (var category in filteredCategories)
                                {
                                    int categoryColspan = category.Value.Sum(dt => devColVis.ContainsKey(dt) ? devColVis[dt].Count(v => v) : 0);
                                    if (categoryColspan > 0)
                                    {
                                        <th class="text-center text-dark" colspan="@categoryColspan" style="background-color: #ffc000;">@category.Key</th>
                                    }
                                }
                            </tr>
                            
                            <!-- Row 2: Device type sub-headers - ONLY visible device types -->
                            <tr>
                                @foreach (var category in filteredCategories)
                                {
                                    foreach (var deviceType in category.Value)
                                    {
                                        int devColspan = devColVis.ContainsKey(deviceType) ? devColVis[deviceType].Count(v => v) : 0;
                                        if (devColspan > 0)
                                        {
                                            <th class="text-center text-dark" colspan="@devColspan" style="background-color: #ffeb9c; font-size: 0.8rem;">
                                                @(deviceType.Contains("||") ? deviceType.Split(new[] { "||" }, StringSplitOptions.None).Last() : deviceType)
                                            </th>
                                        }
                                    }
                                }
                            </tr>
                            
                            <!-- Row 3: Column sub-headers -->
                            <tr>
                                <!-- Geo Coordinates sub-headers -->
                                <th class="text-center text-white" style="background-color: #2f75b5; font-size: 0.75rem;">Latitude</th>
                                <th class="text-center text-white" style="background-color: #2f75b5; font-size: 0.75rem;">Longitude</th>
                                <th class="text-center text-white" style="background-color: #2f75b5; font-size: 0.75rem;">Link</th>
                                
                                <!-- Device sub-columns - ONLY for visible device types -->
                                @foreach (var deviceType in visibleDeviceTypes)
                                {
                                    var vis = devColVis.ContainsKey(deviceType) ? devColVis[deviceType] : new bool[] { true, true, false, false };
                                    if (vis[0])
                                    {
                                        <th class="text-center" style="background-color: #fff9e6; font-size: 0.65rem; font-weight: 600;">Existing</th>
                                    }
                                    if (vis[1])
                                    {
                                        <th class="text-center" style="background-color: #c6efce; font-size: 0.65rem; font-weight: 600;">Required</th>
                                    }
                                    if (vis[2])
                                    {
                                        <th class="text-center" style="background-color: #fff2cc; font-size: 0.65rem;">Images</th>
                                    }
                                    if (vis[3])
                                    {
                                        <th class="text-center" style="background-color: #fff2cc; font-size: 0.65rem;">Remarks</th>
                                    }
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var location in requirementSummary.Locations)
                            {
                                <tr>
                                    <!-- SL.No -->
                                    <td class="text-center align-middle fw-bold" style="background-color: #e2efda;">@location.SlNo</td>
                                    
                                    <!-- Location Name -->
                                    <td class="align-middle" style="background-color: #e2efda;">
                                        @location.LocationName
                                        @if (!string.IsNullOrEmpty(location.LocationType))
                                        {
                                            <br /><small class="text-muted">(@location.LocationType)</small>
                                        }
                                    </td>
                                    
                                    <!-- Geo Coordinates -->
                                    <td class="text-center align-middle" style="font-size: 0.75rem; background-color: #ddebf7;">
                                        @(string.IsNullOrEmpty(location.Latitude) ? "" : location.Latitude)
                                    </td>
                                    <td class="text-center align-middle" style="font-size: 0.75rem; background-color: #ddebf7;">
                                        @(string.IsNullOrEmpty(location.Longitude) ? "" : location.Longitude)
                                    </td>
                                    <td class="text-center align-middle" style="background-color: #ddebf7; font-size: 0.7rem;">
                                        @if (!string.IsNullOrEmpty(location.GoogleMapsLink))
                                        {
                                            <a href="@location.GoogleMapsLink" target="_blank" title="Open in Google Maps" style="color: #0563c1; text-decoration: underline;">
                                                maps.google.com/
                                            </a>
                                        }
                                    </td>
                                    
                                    <!-- Device Matrix columns - ONLY for visible device types -->
                                    @foreach (var deviceType in visibleDeviceTypes)
                                    {
                                        // Find matching device data (case-insensitive)
                                        var deviceData = location.DeviceData
                                            .FirstOrDefault(d => d.Key.Equals(deviceType, StringComparison.OrdinalIgnoreCase)).Value
                                            ?? new SurveyApp.Models.DeviceRequirementData();
                                        
                                        string uomSuffix = (deviceData.UOM?.Trim().Equals("MTR", StringComparison.OrdinalIgnoreCase) == true) ? " mtr" : "";
                                        var vis = devColVis.ContainsKey(deviceType) ? devColVis[deviceType] : new bool[] { true, true, false, false };

                                        <!-- Existing column -->
                                        @if (vis[0])
                                        {
                                            <td class="text-center align-middle" style="background-color: @(deviceData.ExistingQty > 0 ? "#fff9e6" : "#fff"); font-size: 0.85rem;">
                                                @if (deviceData.ExistingQty > 0)
                                                {
                                                    <span class="fw-bold">@deviceData.ExistingQty@uomSuffix</span>
                                                }
                                            </td>
                                        }
                                        
                                        <!-- Required column -->
                                        @if (vis[1])
                                        {
                                            <td class="text-center align-middle" style="background-color: @(deviceData.RequiredQty > 0 ? "#c6efce" : "#fff"); font-size: 0.85rem;">
                                                @if (deviceData.RequiredQty > 0)
                                                {
                                                    <span class="fw-bold text-success">@deviceData.RequiredQty@uomSuffix</span>
                                                }
                                            </td>
                                        }
                                        
                                        <!-- Images column -->
                                        @if (vis[2])
                                        {
                                            <td class="text-center align-middle" style="background-color: #fff;">
                                                @if (deviceData.ImageUrls?.Any() == true)
                                                {
                                                    <button type="button" class="btn btn-sm btn-link p-0" onclick="showImageGallery('@string.Join(",", deviceData.ImageUrls).Replace("'", "\\'")', '@(deviceType.Contains("||") ? deviceType.Split(new[] { "||" }, StringSplitOptions.None).Last().Replace("'", "\\'") : deviceType.Replace("'", "\\'"))')" title="View @deviceData.ImageUrls.Count Image(s)">
                                                        <i class="bi bi-images text-primary" style="font-size: 1.1rem;"></i>
                                                    </button>
                                                }
                                            </td>
                                        }
                                        
                                        <!-- Remarks column -->
                                        @if (vis[3])
                                        {
                                            <td class="text-center align-middle" style="background-color: #fff; font-size: 0.7rem;">
                                                @if (!string.IsNullOrEmpty(deviceData.Remarks))
                                                {
                                                    <span title="@deviceData.Remarks" style="cursor: help;">
                                                        <i class="bi bi-chat-text text-info"></i>
                                                    </span>
                                                }
                                            </td>
                                        }
                                    }
                                </tr>
                            }
                        </tbody>
                        <!-- Total Row -->
                        <tfoot>
                            <tr style="background-color: #fce4d6; font-weight: bold;">
                                <td class="text-center align-middle" style="background-color: #f4b084;" colspan="2">
                                    <strong>TOTAL</strong>
                                </td>
                                <td colspan="3" style="background-color: #f4b084;"></td>
                                
                                @foreach (var deviceType in visibleDeviceTypes)
                                {
                                        var existingTotal = existingTotals.ContainsKey(deviceType) ? existingTotals[deviceType] : 0;
                                        var requiredTotal = requiredTotals.ContainsKey(deviceType) ? requiredTotals[deviceType] : 0;
                                        var vis = devColVis.ContainsKey(deviceType) ? devColVis[deviceType] : new bool[] { true, true, false, false };

                                        // Find matching device data to get UOM (from the first location that has it)
                                        var deviceWithUom = requirementSummary.Locations.SelectMany(l => l.DeviceData)
                                            .FirstOrDefault(d => d.Key.Equals(deviceType, StringComparison.OrdinalIgnoreCase)).Value;
                                        string summaryUomSuffix = (deviceWithUom?.UOM?.Trim().Equals("MTR", StringComparison.OrdinalIgnoreCase) == true) ? " mtr" : "";
                                    
                                    <!-- Total Existing -->
                                    @if (vis[0])
                                    {
                                        <td class="text-center align-middle" style="background-color: #f4b084; font-size: 0.9rem;">
                                            @if (existingTotal > 0)
                                            {
                                                <strong>@existingTotal@summaryUomSuffix</strong>
                                            }
                                            else
                                            {
                                                <span class="text-muted">0</span>
                                            }
                                        </td>
                                    }
                                    <!-- Total Required -->
                                    @if (vis[1])
                                    {
                                        <td class="text-center align-middle" style="background-color: #92d050; font-size: 0.9rem;">
                                            @if (requiredTotal > 0)
                                            {
                                                <strong>@requiredTotal@summaryUomSuffix</strong>
                                            }
                                            else
                                            {
                                                <span class="text-muted">0</span>
                                            }
                                        </td>
                                    }
                                    <!-- Empty Images column for total row -->
                                    @if (vis[2]) { <td style="background-color: #fce4d6;"></td> }
                                    <!-- Empty Remarks column for total row -->
                                    @if (vis[3]) { <td style="background-color: #fce4d6;"></td> }
                                }
                            </tr>
                        </tfoot>
                        }
                        else
                        {
                            <tbody>
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">
                                        <i class="bi bi-inbox" style="font-size: 2rem;"></i>
                                        <p class="mb-0 mt-2">No device data with quantities greater than 0 found.</p>
                                    </td>
                                </tr>
                            </tbody>
                        }
                    </table>
                </div>
            }
            else if (ViewBag.SelectedSurveyId != null)
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
                    <p class="text-muted mt-2">No locations with devices found for this survey.</p>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-hand-index-thumb text-muted" style="font-size: 3rem;"></i>
                    <p class="text-muted mt-2">Select a survey from the dropdown above or click the <i class="bi bi-table"></i> button next to a survey to view the requirement summary.</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/reportOTP.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // OTP Export Handler
        $(document).ready(function() {
            $('#btnExportExcel').on('click', function() {
                var btn = $(this);
                var params = {
                    fromDate: btn.data('from-date'),
                    toDate: btn.data('to-date'),
                    status: btn.data('status'),
                    region: btn.data('region'),
                    type: btn.data('type')
                };

                // Build download URL
                var downloadUrl = '@Url.Action("ExportToExcel")';
                var queryParts = [];
                if (params.fromDate) queryParts.push('fromDate=' + params.fromDate);
                if (params.toDate) queryParts.push('toDate=' + params.toDate);
                if (params.status) queryParts.push('status=' + encodeURIComponent(params.status));
                if (params.region) queryParts.push('region=' + encodeURIComponent(params.region));
                if (params.type) queryParts.push('type=' + encodeURIComponent(params.type));
                if (queryParts.length > 0) {
                    downloadUrl += '?' + queryParts.join('&');
                }

                // Use OTP module to check and download
                ReportOTPModule.checkAndDownload('SummaryExcel', params, downloadUrl);
            });
        });

        // Requirement Summary Functions
        function showRequirementSummary(surveyId) {
            // Set the dropdown value
            $('#surveySelector').val(surveyId);
            // Load the summary
            loadRequirementSummary();
        }

        function loadRequirementSummary() {
            var selectedSurveyId = $('#surveySelector').val();
            if (!selectedSurveyId) {
                return;
            }
            
            // Build URL with current filter parameters and selected survey
            var currentUrl = new URL(window.location.href);
            currentUrl.searchParams.set('selectedSurveyId', selectedSurveyId);
            
            // Navigate to the new URL (this will reload the page with the requirement summary)
            window.location.href = currentUrl.toString();
        }

        // Scroll to requirement summary if a survey is selected
        $(document).ready(function() {
            @if (ViewBag.SelectedSurveyId != null)
            {
                <text>
                // Scroll to the requirement summary section
                setTimeout(function() {
                    var element = document.getElementById('requirementSummarySection');
                    if (element) {
                        element.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    }
                }, 300);
                </text>
            }
        });

        // Modern Chart.js configuration with better styling
        Chart.defaults.font.family = "'Segoe UI', 'Roboto', sans-serif";
        
        // Status Chart
        @if (Model.SurveysByStatus.Any())
        {
            <text>
            const statusCtx = document.getElementById('statusChart').getContext('2d');
            new Chart(statusCtx, {
                type: 'doughnut',
                data: {
                    labels: @Html.Raw(Json.Serialize(Model.SurveysByStatus.Keys)),
                    datasets: [{
                        data: @Html.Raw(Json.Serialize(Model.SurveysByStatus.Values)),
                        backgroundColor: [
                            'rgba(6, 214, 160, 0.9)',
                            'rgba(255, 201, 60, 0.9)',
                            'rgba(108, 117, 125, 0.9)',
                            'rgba(255, 107, 107, 0.9)',
                            'rgba(102, 126, 234, 0.9)'
                        ],
                        borderWidth: 0,
                        hoverOffset: 10
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    plugins: {
                        legend: { 
                            position: 'bottom',
                            labels: {
                                padding: 15,
                                usePointStyle: true,
                                font: { size: 12 }
                            }
                        },
                        tooltip: {
                            backgroundColor: 'rgba(0, 0, 0, 0.8)',
                            padding: 12,
                            titleFont: { size: 14 },
                            bodyFont: { size: 13 }
                        }
                    }
                }
            });
            </text>
        }

        // Region Chart
        @if (Model.SurveysByRegion.Any())
        {
            <text>
            const regionCtx = document.getElementById('regionChart').getContext('2d');
            new Chart(regionCtx, {
                type: 'pie',
                data: {
                    labels: @Html.Raw(Json.Serialize(Model.SurveysByRegion.Keys)),
                    datasets: [{
                        data: @Html.Raw(Json.Serialize(Model.SurveysByRegion.Values)),
                        backgroundColor: [
                            'rgba(102, 126, 234, 0.9)',
                            'rgba(118, 75, 162, 0.9)',
                            'rgba(240, 147, 251, 0.9)',
                            'rgba(79, 172, 254, 0.9)',
                            'rgba(0, 242, 254, 0.9)'
                        ],
                        borderWidth: 0,
                        hoverOffset: 10
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    plugins: {
                        legend: { 
                            position: 'bottom',
                            labels: {
                                padding: 15,
                                usePointStyle: true,
                                font: { size: 12 }
                            }
                        },
                        tooltip: {
                            backgroundColor: 'rgba(0, 0, 0, 0.8)',
                            padding: 12,
                            titleFont: { size: 14 },
                            bodyFont: { size: 13 }
                        }
                    }
                }
            });
            </text>
        }

        // Type Chart
        @if (Model.SurveysByImplementationType.Any())
        {
            <text>
            const typeCtx = document.getElementById('typeChart').getContext('2d');
            new Chart(typeCtx, {
                type: 'bar',
                data: {
                    labels: @Html.Raw(Json.Serialize(Model.SurveysByImplementationType.Keys)),
                    datasets: [{
                        label: 'Surveys',
                        data: @Html.Raw(Json.Serialize(Model.SurveysByImplementationType.Values)),
                        backgroundColor: 'rgba(102, 126, 234, 0.8)',
                        borderColor: 'rgba(102, 126, 234, 1)',
                        borderWidth: 2,
                        borderRadius: 8,
                        hoverBackgroundColor: 'rgba(102, 126, 234, 1)'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: 'rgba(0, 0, 0, 0.8)',
                            padding: 12,
                            titleFont: { size: 14 },
                            bodyFont: { size: 13 }
                        }
                    },
                    scales: {
                        y: { 
                            beginAtZero: true,
                            grid: {
                                color: 'rgba(0, 0, 0, 0.05)'
                            },
                            ticks: {
                                font: { size: 11 }
                            }
                        },
                        x: {
                            grid: {
                                display: false
                            },
                            ticks: {
                                font: { size: 11 }
                            }
                        }
                    }
                }
            });
            </text>
        }
    </script>
}

<style>
    .text-purple {
        color: #667eea !important;
    }
    
    .bg-purple {
        background-color: #667eea !important;
    }
    
    .btn-purple {
        background-color: #667eea;
        border-color: #667eea;
        color: white;
    }
    
    .btn-purple:hover {
        background-color: #5568d3;
        border-color: #5568d3;
        color: white;
    }
    
    .btn-outline-purple {
        border-color: #667eea;
        color: #667eea;
    }
    
    .btn-outline-purple:hover {
        background-color: #667eea;
        border-color: #667eea;
        color: white;
    }
    
    /* Card hover effects */
    .card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    
    .card:hover {
        transform: translateY(-2px);
    }
    
    /* Table styling enhancements */
    .table tbody tr {
        transition: background-color 0.2s ease;
    }
    
    .table tbody tr:hover {
        background-color: rgba(102, 126, 234, 0.05);
    }
    
    /* Badge enhancements */
    .badge {
        font-weight: 500;
        letter-spacing: 0.3px;
    }
    
    /* Print styles */
    @@media print {
        .no-print {
            display: none !important;
        }
        .card {
            border: 1px solid #ddd !important;
            box-shadow: none !important;
            page-break-inside: avoid;
        }
        .btn, button {
            display: none !important;
        }
    }
    
    /* Responsive adjustments */
    @@media (max-width: 768px) {
        .card-body {
            padding: 1rem !important;
        }
        h2 {
            font-size: 1.5rem;
        }
    }
    
    /* Ultra-compact table styles */
    .table-compact th, .table-compact td {
        padding: 2px 4px !important;
        line-height: 1.1 !important;
        vertical-align: middle !important;
    }
    .table-compact th {
        font-size: 0.7rem !important;
    }
    .table-compact td {
        font-size: 0.75rem !important;
    }

    #requirementSummarySection .table-responsive {
        max-height: 600px;
        overflow-y: auto;
    }
    
    /* Excel-like header colors */
    #requirementSummarySection .bg-location-header {
        background-color: #70ad47 !important;
        color: white;
    }
    
    #requirementSummarySection .bg-geo-header {
        background-color: #5b9bd5 !important;
        color: white;
    }
    
    #requirementSummarySection .bg-camera-header {
        background-color: #ffc000 !important;
        color: #333;
    }
    
    /* Alternating row colors for locations */
    #requirementSummarySection tbody tr:nth-child(even) {
        background-color: #f8f9fa;
    }
    
    #requirementSummarySection tbody tr:hover {
        background-color: #e8f5e9 !important;
    }
</style>
